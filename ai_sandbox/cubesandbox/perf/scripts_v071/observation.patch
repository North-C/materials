+// Copyright (c) 2024 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package workflow
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/perftrace"
+)
+
+// Run once with CUBE_PERF_TRACE unset and once with CUBE_PERF_TRACE=1: the
+// switch is deliberately read at process startup, not on each metric call.
+func TestPerfTraceShortMetricGate(t *testing.T) {
+	info := &CreateContext{}
+	ctx := context.WithValue(context.Background(), KCreateContext, info)
+	ctx, collector := perftrace.StartRequest(ctx, time.Now(), "test-request")
+	RecordCreateMetricIfGreaterThan(ctx, nil, "short", 125*time.Nanosecond, time.Millisecond)
+	RecordCreateMetricIfGreaterThan(ctx, nil, "long", 2*time.Millisecond, time.Millisecond)
+	metrics := info.GetMetric()
+	if !perftrace.Enabled() {
+		if len(metrics) != 1 || metrics[0].ID() != "long" {
+			t.Fatalf("changed default gate: %+v", metrics)
+		}
+		return
+	}
+	if len(metrics) != 2 || metrics[0].Duration() != 125*time.Nanosecond {
+		t.Fatalf("lost short metric: %+v", metrics)
+	}
+	batch := collector.Finish("sandbox", time.Now(), nil)
+	if len(batch.Spans) != 3 || batch.Spans[0].DurationUS != .125 {
+		t.Fatalf("lost precision: %+v", batch)
+	}
+}
