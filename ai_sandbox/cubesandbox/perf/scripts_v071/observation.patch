+++ b/Cubelet/pkg/perftrace/trace_test.go
@@ -0,0 +1,112 @@
+// Copyright (c) 2024 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package perftrace
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func setEnabled(t *testing.T, on bool) {
+	previous := enabled
+	enabled = on
+	t.Cleanup(func() { enabled = previous })
+}
+
+func TestDisabledDoesNotAllocateOrAlterContext(t *testing.T) {
+	setEnabled(t, false)
+	ctx := context.Background()
+	got, c := StartRequest(ctx, time.Now(), "r")
+	if got != ctx || c != nil {
+		t.Fatal("disabled collector allocated")
+	}
+	got, span := Begin(ctx, "short", "test")
+	if got != ctx || span != nil {
+		t.Fatal("disabled span allocated")
+	}
+	span.End(nil)
+	RecordDuration(ctx, "short", time.Nanosecond, nil)
+	if c.Finish("s", time.Now(), nil) != nil {
+		t.Fatal("disabled finish emitted")
+	}
+}
+
+func TestIntervalsRetainSubMicrosecondTimingAndOriginalEndpoint(t *testing.T) {
+	setEnabled(t, true)
+	origin := time.Now()
+	ctx, c := StartRequest(context.Background(), origin, "request")
+	RecordInterval(ctx, "short", "test", origin.Add(1750*time.Nanosecond), origin.Add(2125*time.Nanosecond), nil)
+	end := origin.Add(5 * time.Millisecond)
+	b := c.Finish("sandbox", end, nil)
+	if b.Spans[0].StartOffsetUS != 1.75 || b.Spans[0].DurationUS != 0.375 {
+		t.Fatalf("lost precision: %+v", b.Spans[0])
+	}
+	if b.Spans[1].DurationUS != 5000 || b.Spans[0].ParentSpanID != 1 {
+		t.Fatalf("wrong endpoint or parent: %+v", b)
+	}
+	payload, err := json.Marshal(b)
+	if err != nil || len(payload) == 0 {
+		t.Fatal(err)
+	}
+	// A later emission/finalization cannot replace recorded endpoints.
+	if c.Finish("sandbox", end.Add(time.Second), nil) != nil {
+		t.Fatal("batch emitted twice")
+	}
+}
+
+func TestParallelRepeatedStagesKeepIdentityAndParents(t *testing.T) {
+	setEnabled(t, true)
+	ctx, c := StartRequest(context.Background(), time.Now(), "request")
+	ctx, group := Begin(ctx, "workflow.parallel_step", "workflow_group")
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			child, action := Begin(ctx, "repeated", "workflow_action")
+			RecordDuration(child, "micro", 250*time.Nanosecond, nil)
+			action.End(nil)
+		}()
+	}
+	wg.Wait()
+	group.End(nil)
+	b := c.Finish("sandbox", time.Now(), nil)
+	if len(b.Spans) != 42 {
+		t.Fatalf("lost repeated spans: %d", len(b.Spans))
+	}
+	ids := map[uint64]Span{}
+	for _, s := range b.Spans {
+		if _, exists := ids[s.SpanID]; exists {
+			t.Fatalf("duplicate id %d", s.SpanID)
+		}
+		ids[s.SpanID] = s
+	}
+	for _, s := range b.Spans {
+		if s.Stage == "repeated" && s.ParentSpanID != group.id {
+			t.Fatalf("wrong group %+v", s)
+		}
+		if s.Stage == "micro" && (ids[s.ParentSpanID].Stage != "repeated" || s.DurationUS != .25 || s.TimingSource != "duration_backfill") {
+			t.Fatalf("wrong child %+v", s)
+		}
+	}
+}
+
+func TestFailureAndFinishedCollector(t *testing.T) {
+	setEnabled(t, true)
+	ctx, c := StartRequest(context.Background(), time.Now(), "r")
+	_, a := Begin(ctx, "failed", "test")
+	a.End(errors.New("failed"))
+	b := c.Finish("s", time.Now(), errors.New("failed"))
+	if b.Spans[0].Success || b.Spans[1].Success {
+		t.Fatal("failure reported as success")
+	}
+	RecordDuration(ctx, "late rollback", time.Second, nil)
+	if len(c.spans) != 1 {
+		t.Fatal("accepted work after request finished")
+	}
+}
