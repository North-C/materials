/*
 * trace_arm64_irq27_entry_pstate_v2.bt
 *
 * Same arming as trace_arm64_irq27_entry_pstate.bt (10,000 vCPU1 WFI traps),
 * but preserves ORDER for the first 200 vCPU1 guest entries after arming
 * (one line each: seq, pc, pstate, used_lrs, vmcr, lr0..lr3), then
 * aggregates PSTATE.I for the next 50,000 entries. This locates the rare
 * I=0 entries inside the storm sequence.
 */

BEGIN
{
    printf("event,ns,tid,note\n");
    @armed = 0;
    @done = 0;
    @seq = 0;
}

kprobe:kvm_handle_wfx
{
    $vcpu = (struct kvm_vcpu *)arg0;
    if ($vcpu->vcpu_id == 1 && @armed == 0) {
        @wfi[tid] += 1;
        if (@wfi[tid] >= 10000) {
            @armed = 1;
            @arm_ns = nsecs;
            printf("arm,%lld,%d,wfi=10000\n", nsecs, tid);
        }
    }
}

kprobe:__kvm_vcpu_run
{
    if (@armed == 0 || @done == 1) {
        return;
    }
    $vcpu = (struct kvm_vcpu *)arg0;
    if ($vcpu->vcpu_id != 1) {
        return;
    }

    @seq += 1;
    @n += 1;
    $ps = $vcpu->arch.ctxt.regs.pstate;
    $pc = $vcpu->arch.ctxt.regs.pc;

    if (@seq <= 200) {
        printf("entry,%lld,%d,seq=%lld pc=%lx ps=%lx i=%d ulrs=%d vmcr=%lx lr0=%lx lr1=%lx lr2=%lx lr3=%lx\n",
               nsecs, tid, @seq, $pc, $ps, ($ps >> 7) & 1,
               $vcpu->arch.vgic_cpu.vgic_v3.used_lrs,
               $vcpu->arch.vgic_cpu.vgic_v3.vgic_vmcr,
               $vcpu->arch.vgic_cpu.vgic_v3.vgic_lr[0],
               $vcpu->arch.vgic_cpu.vgic_v3.vgic_lr[1],
               $vcpu->arch.vgic_cpu.vgic_v3.vgic_lr[2],
               $vcpu->arch.vgic_cpu.vgic_v3.vgic_lr[3]);
    }

    if (($ps >> 7) & 1) {
        @i1 += 1;
    } else {
        @i0 += 1;
        @seq_i0[@seq] = $pc;
        @pc_i0[$pc] = count();
    }

    if (@n >= 50000 && @done == 0) {
        @done = 1;
        printf("done,%lld,%d,entries=%lld i0=%lld i1=%lld window_ns=%lld\n",
               nsecs, tid, @n, @i0, @i1, nsecs - @arm_ns);
        exit();
    }
}

END
{
    printf("summary,entries,%lld\n", @n);
    printf("summary,entries_i1_masked,%lld\n", @i1);
    printf("summary,entries_i0_unmasked,%lld\n", @i0);
    printf("summary,i0_seq_to_pc,below\n");
    print(@seq_i0);
    printf("summary,i0_pc_histogram,below\n");
    print(@pc_i0);
    clear(@wfi);
    clear(@seq_i0);
    clear(@pc_i0);
}
