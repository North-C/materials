/*
 * trace_arm64_irq27_entry_pstate.bt
 *
 * Question: during the vCPU1 WFI storm after template snapshot restore,
 * does the guest ever run with PSTATE.I == 0 (IRQ unmasked)?
 *
 *   - If every guest entry has I=1, the guest never unmasks IRQs, so the
 *     pending LRs can never be taken: the stall is on the guest-side
 *     unmask/vector path.
 *   - If I=0 entries occur while LR0 stays PENDING, the vIRQ injection
 *     path is broken below the guest.
 *
 * Method: arm when one KVM thread accumulates 10,000 vCPU1 WFI traps
 * (same trigger as trace_arm64_wfi_vgic.bt), then aggregate every
 * __kvm_vcpu_run entry of vCPU1 by PSTATE.I, with PC / PSTATE / LR0
 * histograms for the I=0 entries. Stop after 50,000 entries.
 *
 * Stock-kernel probes only (BTF), no hard-coded offsets.
 */

BEGIN
{
    printf("event,ns,tid,note\n");
    @armed = 0;
    @done = 0;
}

kprobe:kvm_handle_wfx
{
    $vcpu = (struct kvm_vcpu *)arg0;
    if ($vcpu->vcpu_id == 1 && @armed == 0) {
        @wfi[tid] += 1;
        if (@wfi[tid] >= 10000) {
            @armed = 1;
            @arm_ns = nsecs;
            @arm_tid = tid;
            printf("arm,%lld,%d,wfi=10000\n", nsecs, tid);
        }
    }
}

kprobe:__kvm_vcpu_run
{
    if (@armed == 0 || @done == 1) {
        return;
    }
    $vcpu = (struct kvm_vcpu *)arg0;
    if ($vcpu->vcpu_id != 1) {
        return;
    }

    @n += 1;
    $ps = $vcpu->arch.ctxt.regs.pstate;
    $pc = $vcpu->arch.ctxt.regs.pc;
    $lr0 = $vcpu->arch.vgic_cpu.vgic_v3.vgic_lr[0];

    if (($ps >> 7) & 1) {
        @i1 += 1;
    } else {
        @i0 += 1;
        @pc_i0[$pc] = count();
        @ps_i0[$ps] = count();
        @lr0_i0[$lr0] = count();
    }

    if (@n >= 50000 && @done == 0) {
        @done = 1;
        printf("done,%lld,%d,entries=%lld i0=%lld i1=%lld window_ns=%lld\n",
               nsecs, tid, @n, @i0, @i1, nsecs - @arm_ns);
        exit();
    }
}

END
{
    printf("summary,entries,%lld\n", @n);
    printf("summary,entries_i1_masked,%lld\n", @i1);
    printf("summary,entries_i0_unmasked,%lld\n", @i0);
    printf("summary,i0_pc_histogram,below\n");
    print(@pc_i0);
    printf("summary,i0_pstate_histogram,below\n");
    print(@ps_i0);
    printf("summary,i0_lr0_histogram,below\n");
    print(@lr0_i0);
    clear(@wfi);
    clear(@pc_i0);
    clear(@ps_i0);
    clear(@lr0_i0);
}
