+
+/// Experimental (perf-tuning-90): mark a file-backed guest mapping MADV_RANDOM so
+/// cold-cache faults allocate order-0 page-cache folios instead of readahead
+/// large folios. With ~100 VMs sharing one snapshot/pmem file, every stage-2 fault
+/// takes a reference on the backing folio; large folios make all their subpages
+/// share one refcount cache line. Enabled only when the flag file exists.
+pub fn perf_madv_random(addr: *mut libc::c_void, len: usize, what: &str) {
+    if !std::path::Path::new("/run/cube-perf/snap_madv_random").exists() {
+        return;
+    }
+    let ret = unsafe { libc::madvise(addr, len, libc::MADV_RANDOM) };
+    if ret != 0 {
+        warn!("{}: MADV_RANDOM failed: {}", what, std::io::Error::last_os_error());
+    } else {
+        info!("{}: MADV_RANDOM applied to 0x{:x} size 0x{:x}", what, addr as u64, len);
+    }
+}
